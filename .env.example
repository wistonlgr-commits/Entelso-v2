# ============================================================
# Entelso Backend — Variables de Entorno
# Copia este archivo a backend/.env y ajusta los valores
# NUNCA subas archivos .env reales al control de versiones (git)
# ============================================================

# Puerto del servidor Express
PORT=3001

# Entorno: development | production | test
NODE_ENV=development

# Cadena de conexión a PostgreSQL / Supabase
# En producción/nube: Supabase Dashboard -> Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[TU_PROJECT_REF].supabase.co:5432/postgres

# Clave de API para la integración con n8n (mínimo 10 caracteres)
# Debe coincidir con el header X-Ingest-Secret configurado en n8n
API_KEY=change_me_ingest_api_key_min_10_chars

# Secreto para firmar JWT del dashboard (mínimo 10 caracteres, cambiar en producción)
JWT_SECRET=change_me_jwt_secret_min_10_chars

# Orígenes permitidos para CORS (separados por coma)
# En desarrollo local / Docker Nginx (puerto 80): http://localhost,http://127.0.0.1
# En producción: dominio o URL pública del dashboard
CORS_ORIGIN=http://localhost,http://127.0.0.1

# Supabase Storage (opcional; dejar vacío si se ejecuta en entorno local aislado)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
